# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Postgres (source-of-truth ledger) ─────────────────────────────────
DATABASE_URL=postgresql://auditer:auditer@localhost:5432/auditer?schema=public
# Dedicated app role that RLS is enforced against (NOT the migration/owner role).
# The owner role bypasses RLS to run migrations; the app connects as this one.
DATABASE_APP_URL=postgresql://auditer_app:auditer_app@localhost:5432/auditer?schema=public

# ── Valkey (BullMQ broker + pub/sub + session/token cache) ────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO in dev; swap endpoint for R2/S3) ────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auditer
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── OpenBao Transit (KEK / envelope encryption) ───────────────────────
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=dev-root-token
OPENBAO_TRANSIT_KEY=auditer-kek

# ── Anthropic (AI layer) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── GitHub App (repo access — distinct from login OAuth) ──────────────
# Register at https://github.com/settings/apps/new. The App gives a SaaS scoped,
# revocable access to a user's repos (they install it and pick repos).
GITHUB_APP_ID=
GITHUB_APP_SLUG=          # the App's URL slug (github.com/apps/<slug>)
GITHUB_APP_PRIVATE_KEY=   # PEM; use \n-escaped single line, or mount the file
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# ── GitLab OAuth (connexion + accès aux dépôts) ───────────────────────
# GitLab n'a pas d'équivalent de la GitHub App : c'est UNE application OAuth
# qui sert aux deux flux, et on stocke un jeton d'accès (~2 h) + un jeton de
# rafraîchissement rotatif, chiffrés. À créer dans GitLab → User Settings →
# Applications, en cochant « Confidential » (l'échange se fait serveur à
# serveur, avec le secret ci-dessous).
#
# Scopes : read_user (connexion), read_api + read_repository (dépôts).
#
# Redirect URIs — DÉCLARER LES DEUX, une par ligne, construites depuis WEB_URL
# (voir plus bas). Un écart d'un seul caractère et GitLab refuse au retour avec
# « redirect_uri mismatch » :
#   <WEB_URL>/api/auth/gitlab/callback         → connexion
#   <WEB_URL>/api/connections/gitlab/callback  → rattachement des dépôts
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Instance auto-hébergée : poser son URL racine (sans / final). Vide ⇒
# https://gitlab.com. Sert aussi au worker pour construire l'URL de clone.
# Attention : une instance sur une adresse privée (RFC1918) reste joignable
# par l'api et le worker, mais PAS depuis les étapes réseau du bac à sable —
# le proxy d'egress (infra/compose/squid/squid.conf) y coupe tout.
GITLAB_URL=https://gitlab.com

# Les trois variables sont lues par l'api ET par le worker : le worker
# rafraîchit lui-même le jeton avant de cloner. Le compose serveur les partage
# déjà via l'ancre &appenv — ne pas les poser sur un seul des deux services.

# ── Connexion à l'application (session cookie GitHub / GitLab) ────────
# Uses GITHUB_APP_CLIENT_ID/SECRET above, ou GITLAB_CLIENT_ID/SECRET pour la
# connexion GitLab. The AuthGuard validates the cookie session; set
# AUTH_DEV_HEADERS=1 to allow x-org-id/x-user-id headers in dev (NEVER in
# production).
#
# Secret HMAC qui signe le paramètre `state` des retours OAuth (GitHub comme
# GitLab). Le callback ne porte aucune session : c'est ce `state` qui rattache
# l'installation ou la connexion à la bonne organisation. Le code retombe sur
# "dev-secret" s'il est absent — en production, cela rend le `state` forgeable,
# donc rattachable à une organisation qui n'est pas la sienne. À poser (32
# caractères aléatoires ou plus) sur tout déploiement exposé.
BETTER_AUTH_SECRET=

AUTH_DEV_HEADERS=0
# Optional dev identity for the web client when AUTH_DEV_HEADERS=1
# (from `pnpm --filter @auditer/db seed`):
NEXT_PUBLIC_DEV_ORG_ID=
NEXT_PUBLIC_DEV_USER_ID=

# ── Sandbox / worker ──────────────────────────────────────────────────
# dockerode targets the socket-proxy, NEVER the raw host socket.
DOCKER_HOST=tcp://localhost:2375
SANDBOX_RUNTIME=runsc
# Per-audit egress allowlist proxy (only network-enabled steps route through it).
EGRESS_PROXY_URL=http://localhost:3128

# ── Rétention ─────────────────────────────────────────────────────────
# La purge applique les durées publiées dans apps/web/lib/legal.ts (journaux
# 90 j, relevés 24 mois, attestations 24 mois, artefacts expirés, sessions
# expirées). Elle est PLANIFIÉE : le worker enregistre un Job Scheduler BullMQ
# sur Valkey au démarrage (apps/worker/src/retention-scheduler.ts). Aucune
# variable n'est requise pour qu'elle tourne — c'est voulu : un ordonnanceur
# qui ne démarre que si quelqu'un pense à poser une variable est le défaut que
# ce code ferme.

# Secret partagé de POST /api/admin/retention/purge, qui lance la MÊME purge à
# la demande (le RGPD promet une purge sous 30 jours sur demande, et un
# opérateur ne doit pas attendre 03h30 UTC). Absente ou < 16 caractères ⇒ 404.
# Les deux chemins prennent le même verrou Valkey : ils ne peuvent pas se
# croiser.
ADMIN_PURGE_TOKEN=

# Mode simulation : compte ce qui partirait, ne supprime rien, et le dit en
# WARN à chaque exécution. Défaut = OFF (la purge supprime réellement).
# À poser à 1 pour la PREMIÈRE exécution sur une base de production : on
# déploie, on lit les compteurs dans le journal du worker le lendemain matin,
# puis on retire la variable et on redéploie. Tant qu'elle vaut 1, les durées
# publiées ne sont PAS appliquées.
RETENTION_PURGE_DRY_RUN=

# Cadence, en cron BullMQ, interprétée en UTC. Défaut : "30 3 * * *"
# (03h30 UTC = 04h30 à Douala). Sert surtout à tester en local avec un
# "*/2 * * * *". Changer la valeur et redémarrer met à jour l'ordonnanceur
# existant (upsert par identifiant), il n'en crée pas un second.
RETENTION_PURGE_CRON=

# ── URLs ──────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
# URL PUBLIQUE du web (le navigateur y revient). Les `redirect_uri` OAuth sont
# construits à partir d'elle : si elle ne correspond pas au caractère près à ce
# qui est déclaré côté GitHub / GitLab, le retour échoue en
# « redirect_uri mismatch » et rien dans les journaux de l'api ne le dit — la
# requête n'arrive jamais jusqu'à nous.
WEB_URL=http://localhost:3000
