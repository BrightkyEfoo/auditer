{
  "name": "@auditer/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "rls": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/sql/rls.sql",
    "rls:verify": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/sql/rls-verify.sql",
    "rls:check": "bash scripts/rls-check.sh",
    "bootstrap": "bash scripts/migrate-deploy.sh",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "studio": "prisma studio",
    "build": "prisma generate && tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@auditer/config": "workspace:*",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3"
  }
}
