  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1"
  },
  "devDependencies": {
    "@auditer/config": "workspace:*",
    "typescript": "^5.7.3"
  }
}
